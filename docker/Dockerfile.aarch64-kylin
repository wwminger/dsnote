# Dockerfile for AArch64 build environment for Speech Note (dsnote)
# Base: cnxc/kylin:desktop-v10sp1 with GCC 9.3.0
# Build: docker buildx build --platform linux/arm64 -t dsnote-aarch64-kylin-builder .
FROM cnxc/kylin:desktop-v10sp1

LABEL maintainer="Michal Kosciesza <michal@mkiol.net>"
LABEL description="AArch64 build environment for Speech Note based on Kylin V10 SP1"
LABEL org.opencontainers.image.source="https://github.com/wwminger/dsnote"

# Set platform for multi-arch builds
ARG TARGETPLATFORM=linux/arm64

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install CMake manually (newer version than distro provides)
# Download and install CMake 4.3.0-rc3 for AArch64
RUN wget -q https://github.com/Kitware/CMake/releases/download/v4.3.0-rc3/cmake-4.3.0-rc3-linux-aarch64.tar.gz -O /tmp/cmake.tar.gz && \
    tar -xzf /tmp/cmake.tar.gz -C /opt && \
    ln -s /opt/cmake-4.3.0-rc3-linux-aarch64 /opt/cmake && \
    rm /tmp/cmake.tar.gz

ENV PATH=/opt/cmake/bin:$PATH

# Update system and install basic tools (cmake removed, using manual install)
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    wget \
    sudo \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y \
    libboost-all-dev \
    libfmt-dev \
    gstreamer1.0-plugins-good \
    hicolor-icon-theme \
    libkf5configwidgets-dev \
    libkf5dbusaddons-dev \
    libkf5iconthemes-dev \
    libarchive-dev \
    libpulse-dev \
    libxinerama-dev \
    libxtst-dev \
    ocl-icd-opencl-dev \
    libopenblas-dev \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswresample-dev \
    python3 \
    python3-pip \
    qtbase5-dev \
    qml-module-qtquick2 \
    qtmultimedia5-dev \
    libqt5x11extras5-dev \
    librubberband-dev \
    libtag1-dev \
    libvulkan-dev \
    libwayland-dev \
    liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

# Install packages that may not be available (ignore failures)
RUN apt-get update && apt-get install -y \
    libglslang-dev \
    || echo "Warning: libglslang-dev not available, skipping..."
RUN apt-get update && apt-get install -y \
    libkf5kirigami2-dev \
    || echo "Warning: libkf5kirigami2-dev not available, skipping..."
RUN apt-get update && apt-get install -y \
    libqt5quickcontrols2-5 \
    || echo "Warning: libqt5quickcontrols2-5 not available, skipping..."

# Install build dependencies (from PKGBUILD makedepends)
RUN apt-get update && apt-get install -y \
    extra-cmake-modules \
    meson \
    patchelf \
    pybind11-dev \
    qttools5-dev \
    && rm -rf /var/lib/apt/lists/*

# Install optional dependencies (ignore failures for unavailable packages)
RUN apt-get update && apt-get install -y \
    ydotool \
    || echo "Warning: ydotool not available, skipping..."


# Create build user
RUN useradd -m builduser && \
    echo "builduser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/builduser && \
    chmod 0440 /etc/sudoers.d/builduser

# Configure git for builduser
RUN su - builduser -c "git config --global --add safe.directory /workspace"

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
